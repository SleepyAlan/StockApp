@model StockApp.ViewModels.StockTrade
@{
  ViewBag.Title = "Trade";
  var displayPrice = Model.Price.ToString("F2");
}

<div id="details" data-stock-symbol="@Model.StockSymbol" hidden></div>
<div class="container card text-start">
  <h3 class="text-primary text">
    <span id="display-name">@Model.StockName</span>
    (<span id="display-symbol">@Model.StockSymbol</span>)
  </h3>
  <h2>
    <span class="text-muted">
      &dollar;
    </span>
    <span id="display-price">
      @displayPrice
    </span>
    <span id="price-arrow"></span>
  </h2>
</div>

@section Scripts {
  <script type="module" src="~/Views/Trade/Index.cshtml.js" asp-append-version="true"></script>
}
@section Styles {
  <link rel="stylesheet" href="~/stockapp.styles.css" asp-appendversion="true" />
}